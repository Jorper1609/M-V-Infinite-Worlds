# Obligatorio: cambia este secreto antes de publicar MingoVerse en Internet.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
PORT=3307
HOST=0.0.0.0
DATA_DIR=/app/data
COOKIE_SECURE=false
# Establece true cuando el acceso HTTPS lo gestione tu reverse proxy.
TRUST_PROXY=1
PUBLIC_ORIGIN=https://mingoverse.example.com
LOG_LEVEL=info
